{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bien-manger-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // workers.dev の URL で公開する
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Instagram のユーザー名（@ なし）
    "IG_USERNAME": "bien_manger_kyoto"
  },
  // 30分ごとに最新投稿を取得
  "triggers": { "crons": ["*/30 * * * *"] },
  // クリック計測を使う場合は、ダッシュボードで Analytics Engine を有効化してから追加:
  // "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "bien_manger_events" }],
  // Instagram の投稿キャッシュと更新済みトークンの保存先
  "kv_namespaces": [{ "binding": "IG_KV", "id": "2532561a5c7f405bb4028b59c90a7715" }]
}
