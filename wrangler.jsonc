{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bien-manger-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // workers.dev の URL で公開する
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // 存在しないURLは public/404.html（英語は public/en/404.html）を表示
    "not_found_handling": "404-page"
  },
  "vars": {
    // Instagram のユーザー名（@ なし）
    "IG_USERNAME": "bien_manger_kyoto"
  },
  // 30分ごとに最新投稿を取得
  "triggers": { "crons": ["*/30 * * * *"] },
  // 予約・電話・地図・Instagram のクリック計測（Analytics Engine、2026-11-27 有効化）
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "bien_manger_events" }],
  // Instagram の投稿キャッシュと更新済みトークンの保存先
  "kv_namespaces": [{ "binding": "IG_KV", "id": "2532561a5c7f405bb4028b59c90a7715" }],

  // 本番ドメイン（2026-11-27 にダッシュボードで追加済み）。デプロイしても外れないよう設定にも書いておく
  "routes": [
    { "pattern": "bien-manger.jp", "custom_domain": true },
    { "pattern": "www.bien-manger.jp", "custom_domain": true }
  ]
}
